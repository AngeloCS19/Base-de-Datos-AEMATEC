rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /resources/{resourceId} {
      allow read: if resource.data.published == true;
      allow create: if request.resource.data.section in ['docentes', 'academico']
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 300
        && request.resource.data.author is string && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 120
        && request.resource.data.type in ['Actividad', 'Juego', 'Planeamiento', 'Guía didáctica', 'Recurso digital']
        && request.resource.data.extension in ['pdf', 'docx', 'pptx', 'xlsx', 'zip']
        && request.resource.data.size is number && request.resource.data.size <= 25 * 1024 * 1024
        && request.resource.data.published == true;
    }
  }
}
